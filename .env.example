# ============================================================================
# OHS Monorepo — single shared environment file.
# Copy to `.env` in this same root directory (gitignored). Every service
# reads its variables from this one file — see the README in each app
# folder for exactly how it's wired in (docker-compose env_file, dotenv
# path, or Vite envDir).
# ============================================================================

# --- Workspace / general -----------------------------------------------
NODE_ENV=development
OHS_ENVIRONMENT=dev
OHS_PROJECT_NAME=ohs-monorepo-template

# --- apps/web-react (Vite) ----------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_NAME="OHS Web Dashboard"
VITE_ENABLE_RISK_ANALYSIS=true

# --- apps/core-platform/gateway-node -------------------------------------
GATEWAY_PORT=3000
FHIR_SERVICE_URL=http://localhost:8080
OAUTH_ISSUER_URL=https://example-auth-provider.com
OAUTH_CLIENT_ID=changeme
OAUTH_CLIENT_SECRET=changeme
JWT_SECRET=changeme

# --- apps/core-platform/service-fhir-java (Spring Boot) ------------------
FHIR_SERVICE_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fhir
SPRING_DATASOURCE_USERNAME=fhir
SPRING_DATASOURCE_PASSWORD=fhir_local_only
FHIR_SERVER_BASE_URL=http://localhost:8080/fhir

# --- apps/core-platform/docker-compose.local.yml (fhir-db / Postgres) ----
POSTGRES_DB=fhir
POSTGRES_USER=fhir
POSTGRES_PASSWORD=fhir_local_only
POSTGRES_PORT=5432

# --- infra/terraform (local CLI only — CI uses repo secrets) ------------
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_REGION=us-east-1
TF_VAR_environment=dev

# --- packages/shared-libraries (local manual publish only — CI uses repo secrets) --
NPM_TOKEN=changeme
MAVEN_USERNAME=changeme
MAVEN_PASSWORD=changeme
